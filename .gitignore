*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env*

# EVE Static Data Export (SDE)
# The app downloads CCP's JSON Lines SDE on startup (see lib/sde-updater.js),
# so the large data files are not committed. The directory itself is kept.
/staticdata/*.json
/staticdata/*.jsonl
/staticdata/.sde-version.json
!/staticdata/.gitkeep
pyfa-export/

# Test files (unless part of official test suite)
test-*.js
debug-*.js

# Debug and temporary test files
debug_*.js
test_*.js

# Sensitive configuration files
config/production.json
config/local.json

# SSL certificates
*.pem
*.key
*.crt
*.csr

# Backup files
*.bak
*.backup
*~

