# Google Gemini AI Configuration (Required)
# Get your API key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# EVE ESI Application Configuration (Required)
# Create an application at: https://developers.eveonline.com/
# Set callback URL to: http://localhost:8080/callback
# Required scopes: esi-location.read_location.v1, esi-location.read_ship_type.v1, esi-fittings.read_fittings.v1
ESI_CLIENT_ID=your_esi_client_id_here
ESI_CLIENT_SECRET=your_esi_client_secret_here

# Session Configuration (Required)
# Generate a random string for session encryption
SESSION_SECRET=your_random_session_secret_here

# Server Configuration
PORT=8080

# Logging Configuration
LOG_LEVEL=info