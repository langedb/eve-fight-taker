{
  "name": "eve-fight-taker",
  "version": "2.5.0",
  "description": "EVE Online fleet management and ship combat analysis tool with dynamic fleet stats, enhanced fitting cards, EFT parsing fixes, dynamic dogma effects processing, and AI-powered tactical recommendations",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "timeout 120s mocha --require @babel/register --timeout 10000 test/**/*.test.js",
    "lint": "eslint lib/ test/ server.js --fix",
    "update-deps": "npm-check-updates -u"
  },
  "dependencies": {
    "@google/genai": "^1.21.0",
    "axios": "^1.11.0",
    "better-sqlite3": "^12.4.1",
    "chai": "^5.3.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-session": "^1.18.0",
    "fs-extra": "^11.3.2",
    "marked": "^13.0.0",
    "mocha": "^11.7.3",
    "sqlite3": "^5.1.7",
    "winston": "^3.18.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/register": "^7.28.3",
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "nodemon": "^3.1.10",
    "npm-check-updates": "^18.0.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.0"
  },
  "keywords": [
    "eve-online",
    "esi",
    "zkillboard",
    "combat",
    "analysis",
    "ai",
    "gemini",
    "tactical",
    "dps-calculation",
    "pyfa",
    "static-data",
    "dogma-effects",
    "hull-bonuses",
    "winston",
    "logging",
    "fleet-management",
    "eft-parsing",
    "fitting-cards",
    "enhanced-ui"
  ],
  "author": "EVE Fight Taker",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/eve-fight-taker.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/eve-fight-taker/issues"
  },
  "homepage": "https://github.com/your-username/eve-fight-taker#readme"
